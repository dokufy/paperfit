package gitlabrepositorygen

import (
	"context"
	"encoding/json"
	"log"
	"net/http"

	"github.com/atoncetti/combiner/internal/logger"
	"github.com/atoncetti/combiner/server/schema"
	"github.com/atoncetti/combiner/internal/service"
	"github.com/atoncetti/combiner/internal/service/project"
	"github.com/atoncetti/combiner/validation"
	"github.com/danielgtaylor/huma/v2"
)

func RegisterOperation(api huma.API,path string, projectService service.ProjectProvider, pdfService service.PDFserviceProvider) {
	huma.Register(api, definition(path), resolver(projectService, pdfService))
}

func definition(path string) huma.Operation {
	return huma.Operation{
		OperationID: "generate-pdf-gitlab-repository",
		Method:      http.MethodPost,
		Path:        path,
		Summary:     "Generates a PDF document from a gitlab repository",
		Tags:        []string{"Generate from gitlab repository"},
		RequestBody: &huma.RequestBody{
			Description: "Input for document generation",
			Required:    true,
			Content: map[string]*huma.MediaType{
				"application/json": {
					Schema: &huma.Schema{
						Type: huma.TypeObject,
						Properties: map[string]*huma.Schema{
							"template": {
								Type: huma.TypeObject,
								Properties: map[string]*huma.Schema{
									"id": {
										Type:        huma.TypeString,
										Description: "ID of the document to generate",
									},
								},
							},
							"input": {
								Type:        huma.TypeObject,
								Description: "Input argument options",
								Properties: map[string]*huma.Schema{
									"arguments": {
										Type:        huma.TypeString,
										Description: "Input arguments that will be replaced in the document",
									},
									"validate": {
										Type:        huma.TypeBoolean,
										Description: "Whether to validate the arguments against a json schema or not",
									},
								},
							},
						},
						Required: []string{"id"},
					},
				},
			},
		},
		Responses: map[string]*huma.Response{
			"200": {
				Description: "Successfully returns a PDF file",
				Headers: map[string]*huma.Param{
					"Content-Type": {
						Schema: &huma.Schema{
							Default: "application/pdf",
						},
						Description: "Content-Type of the response",
						In:          "header",
						Required:    true,
					},
				},
				Content: map[string]*huma.MediaType{
					"application/pdf": {
						Schema: &huma.Schema{
							Description: "PDF file",
							Type:        huma.TypeString,
							Format:      "binary",
							Required:    []string{"file"},
						},
					},
				},
			},
			"404": {
				Description: "Document ID not found",
			},
			"422": {
				Description: "PDF document could not be generated",
			},
			"500": {
				Description: "Internal server error",
			},
		},
	}
}

func resolver(projectService service.ProjectProvider, pdfService service.PDFserviceProvider) func(ctx context.Context, input *schema.DocumentInput) (*schema.DocumentOutput, error) {
	return func(ctx context.Context, input *schema.DocumentInput) (*schema.DocumentOutput, error) {
		resp := &schema.DocumentOutput{}

		pr, err := projectService.GetProject(input.Body.ID)
		if err != nil {
			if projectErr, ok := err.(*project.RequestError); ok {
				if projectErr.StatusCode == 404 {
					return nil, huma.Error404NotFound("Project not found")
				}
			}
			logger.Logger.Error("failed to get project.")
			return nil, huma.Error500InternalServerError("Failed to get project from repository")
		}

		if input.Body.Input.Validate {
			jsonSchema := pr.GetJSONschema()
			log.Printf("%+v\n", jsonSchema)
			if jsonSchema == nil {
				logger.Logger.Error("no json schema found in the project, please check that a json schema exists in the repository")

				return nil, huma.Error404NotFound("No json schema found in the project, please check that a json schema exists in the repository or disable arguments validation")
			}

			err := validation.Validate([]byte(input.Body.Input.Arguments), *jsonSchema.GetContent())
			if err != nil {
				logger.Logger.Error(err.Error())
				return nil, huma.Error400BadRequest("Provided arguments do not conform to the json schema")
			}
		}

		if input.Body.Input.Arguments != "" {
			var parsedArgs map[string]interface{}
			err = json.Unmarshal([]byte(input.Body.Input.Arguments), &parsedArgs)
			if err != nil {
				logger.Logger.Error("failed to parse arguments.")
				return nil, huma.Error500InternalServerError("Failed to parse arguments", err)
			}

			AppendArgumentsFile(pr, input.Body.Input.Arguments)
		}

		res, err := pdfService.Generate(pr.GetFiles())
		if err != nil {
			logger.Logger.Error(err.Error())
			logger.Logger.Error("failed to generate pdf.")
			return nil, huma.Error500InternalServerError("Failed to generate pdf")
		}

		resp.Body = res

		return resp, nil
	}
}

func AppendArgumentsFile(pr *project.Project, arguments string) error {
	pr.AppendFiles(project.NewFile("index.js", []byte("window.test = "+arguments+";\n")))

	return nil
}
