package gitlabrepositorygen_test

import (
	"context"
	"testing"

	"github.com/atoncetti/combiner/server/operation/gitlabrepositorygen"
	"github.com/atoncetti/combiner/test/mocks"
	"github.com/danielgtaylor/huma/v2/humatest"
	"github.com/go-chi/chi/v5"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/mock"
	"github.com/stretchr/testify/suite"
)

type TestSuite struct {
	suite.Suite
	ctx    context.Context
	api    humatest.TestAPI
	router chi.Router
	assert *assert.Assertions
}

func (s *TestSuite) SetupSuite() {
	router, api := humatest.New(s.T())

	s.api = api
	s.router = router
	s.assert = assert.New(s.T())
}

func (s *TestSuite) TestGeneratePDF_200() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "existing_template_non_existing_schema").Return()
	pdfServiceMock.On("Generate", mock.Anything).Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id": "existing_template_non_existing_schema",
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertExpectations(s.T())

	s.assert.Equal(200, resp.Code)
}

func (s *TestSuite) TestGeneratePDF_WithValidateArguments200() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "existing_template_existing_schema").Return()
	pdfServiceMock.On("Generate", mock.Anything).Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id":                "existing_template_existing_schema",
		"arguments":         "{\"title\": \"this is a title\"}",
		"validateArguments": true,
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertExpectations(s.T())

	s.assert.Equal(200, resp.Code)
}

func (s *TestSuite) TestGeneratePDF_WithValidateArgumentsEmptySchema200() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "existing_template_existing_empty_schema").Return()
	pdfServiceMock.On("Generate", mock.Anything).Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id": "existing_template_existing_empty_schema",
		"input": map[string]any{
			"arguments": "{\"test\": \"some_value\"}",
			"validate":  true,
		},
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertExpectations(s.T())

	s.assert.Equal(200, resp.Code)
}

func (s *TestSuite) TestFailsToGeneratePDF_TemplateNotFound404() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "non_existing").Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id": "non_existing",
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertNotCalled(s.T(), "Generate", mock.Anything)

	s.assert.Equal(404, resp.Code)
}

func (s *TestSuite) TestFailsToGeneratePDF_JSONschemaRequiredAndNotFound404() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "existing_template_non_existing_schema").Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id": "existing_template_non_existing_schema",
		"input": map[string]any{
			"arguments": "{\"test\": \"some_value\"}",
			"validate":  true,
		},
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertNotCalled(s.T(), "Generate", mock.Anything)

	s.assert.Equal(404, resp.Code)
}

func (s *TestSuite) TestFailsToGeneratePDF_FailsToValidateArguments400() {
	projectServiceMock := new(mocks.ProjectServiceMock)
	pdfServiceMock := new(mocks.PDFserviceMock)

	projectServiceMock.On("GetProject", "existing_template_existing_schema").Return()

	gitlabrepositorygen.RegisterOperation(s.api, "/pdf/generate/gitlab/repository", projectServiceMock, pdfServiceMock)

	resp := s.api.Post("/pdf/generate/gitlab/repository", map[string]any{
		"id": "existing_template_existing_schema",
		"input": map[string]any{
			"arguments": "{\"test\": \"some_value\"}",
			"validate":  true,
		},
	})

	projectServiceMock.AssertExpectations(s.T())
	pdfServiceMock.AssertNotCalled(s.T(), "Generate", mock.Anything)

	s.assert.Equal(400, resp.Code)
}

func TestSuccessfulGeneration(t *testing.T) {
	t.Parallel()

	suite.Run(t, new(TestSuite))
}
