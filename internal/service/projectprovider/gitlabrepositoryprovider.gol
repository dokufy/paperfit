	"io"
	"os"

	"github.com/atoncetti/combiner/internal/logger"
	"github.com/atoncetti/combiner/internal/service/project"
	"github.com/mholt/archiver/v4"
	"github.com/xanzy/go-gitlab"
)

type GitlabRepositoryProvider struct {
	client   *gitlab.Client
}

func NewGitlabRepositoryProvider(baseUrl string, token string) (*GitlabRepositoryProvider, error) {
	client, err := gitlab.NewClient(token, gitlab.WithBaseURL(baseUrl))
	if err != nil {
		logger.Logger.Error("Failed to create client.")

		return nil, err
	}

	return &GitlabRepositoryProvider{client: client}, nil
}

func (p *GitlabRepositoryProvider) GetProject(projectID string) (*project.Project, error) {
	archiveFormat := "tar.gz"
	path := "./"

	fileList := []*project.File{}

	format := archiver.CompressedArchive{
		Compression: archiver.Gz{},
		Archival:    archiver.Tar{},
	}

	archiveResponse, _, err := p.client.Repositories.Archive(
		projectID,
		&gitlab.ArchiveOptions{Format: &archiveFormat, Path: &path},
	)
	if err != nil {
		logger.Logger.Error("Failed to get repository archive.")
		if gitlabErr, ok := err.(*gitlab.ErrorResponse); ok {
			return nil, &project.RequestError{StatusCode: gitlabErr.Response.StatusCode, Message: gitlabErr.Message, Err: err}
		}

		return nil, err
	}

	handler := func(ctx context.Context, f archiver.File) error {
		if f.IsDir() {
			return nil
		}

		c, err := f.Open()
		if err != nil {
			return err
		}
		defer c.Close()

		file := project.NewFile(
			f.Name(),
			make([]byte, f.Size()),
		)

		_, err = io.ReadFull(c, *file.GetContent())
		if err != nil {
			return err
		}
		fileList = append(fileList, file)

		return nil
	}

	err = format.Extract(context.Background(), bytes.NewReader(archiveResponse), nil, handler)
	if err != nil {
		return nil, err
	}
	b1, err := os.ReadFile("../acrevis-expert/index.html")
	fileList = append(fileList, project.NewFile("index.html", b1))
	return project.NewProject(fileList), nil
